{
  "sites": [
    {
      "url": "http://localhost:4000",
      "maxPages": 20,
      "forms": [
        { "page": "/contact", "selector": "form#contact", "mode": "intercept", "fields": { "#email": "qa@example.com", "#message": "hello from qa" } },
        { "page": "/contact", "selector": "form#contact", "mode": "submit", "successText": "Thanks, we got your message", "fields": { "#email": "qa@example.com" } },
        { "page": "/contact", "selector": "form#broken", "mode": "submit", "fields": { "#name": "QA" } },
        { "page": "/contact", "selector": "form#required", "mode": "intercept" },
        { "page": "/tracked", "selector": "form#tracked-broken", "mode": "intercept", "fields": { "#tb-email": "qa@example.com" } },
        { "page": "/tracked", "selector": "form#tracked-broken", "mode": "submit", "fields": { "#tb-email": "qa@example.com" } },
        { "page": "/tracked", "selector": "form#tracked", "mode": "intercept", "fields": { "#t-email": "qa@example.com", "#plan-pro": false } },
        { "page": "/tracked", "selector": "form#tracked", "mode": "submit", "fields": { "#t-email": "qa@example.com" } }
      ]
    }
  ],
  "thresholds": { "loadMs": 3000, "lcpMs": 2500, "pageWeightKb": 3000 },
  "checkExternalLinks": false
}
