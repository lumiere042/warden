{
  "sites": [
    {
      "url": "https://example.com",
      "maxPages": 50,
      "forms": [
        {
          "page": "/contact",
          "selector": "form#contact",
          "mode": "intercept",
          "fields": {
            "#email": "qa-test@example.com",
            "#message": "Automated QA test - please ignore"
          }
        }
      ]
    }
  ],
  "thresholds": {
    "loadMs": 3000,
    "lcpMs": 2500,
    "pageWeightKb": 3000,
    "clsScore": 0.1
  },
  "checkExternalLinks": true,
  "pageConcurrency": 3,
  "pageTimeoutMs": 30000,
  "device": null,
  "exclude": ["/wp-admin", "mailto:", "tel:", "javascript:"]
}
