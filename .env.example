# Copy to .env for local runs. In GitHub Actions, add these as repository secrets instead.

# --- Email (required unless you run with --no-email) ---
# resend | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=QA Bot <qa@yourdomain.com>
# Comma-separated list
EMAIL_TO=you@yourdomain.com

# Resend (https://resend.com) - used when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMTP - used when EMAIL_PROVIDER=smtp (e.g. Gmail: smtp.gmail.com, 465, an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- AI summary (optional - leave all of this empty to skip it) ---
# Pick ONE provider. If AI_PROVIDER is empty, it's inferred from whichever key below is set.
#   anthropic          Claude (default model claude-opus-5-5)
#   openai             OpenAI (AI_MODEL required)
#   gemini             Google Gemini (AI_MODEL required)
#   openai-compatible  Ollama, LM Studio, OpenRouter, Groq, ... (AI_BASE_URL + AI_MODEL required)
#   ./my-provider.js   your own adapter file (see README "Use a different AI")
#   none               turn the AI summary off
AI_PROVIDER=

# Either the vendor-specific key...
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# ...or one generic key for whichever provider you picked (overrides the above)
AI_API_KEY=

# AI_MODEL=claude-opus-5-5
# AI_BASE_URL=http://localhost:11434/v1
# Edit the instructions the AI follows by pointing at your own prompt file (default: prompts/summary.md)
# AI_PROMPT_FILE=prompts/summary.md
# AI_MAX_TOKENS=16000
