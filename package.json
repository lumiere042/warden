{
  "name": "warden",
  "version": "0.1.0",
  "description": "On-demand website QA: broken links, missing meta tags, slow pages and broken forms, emailed as an HTML report.",
  "type": "module",
  "bin": {
    "warden": "src/cli.js"
  },
  "scripts": {
    "qa": "node src/cli.js",
    "serve": "node src/cli.js --serve",
    "fixture": "node test/fixture-site/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "qa",
    "seo",
    "broken-links",
    "playwright",
    "monitoring",
    "github-actions"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^18.0.9",
    "nodemailer": "^10.2.1",
    "playwright": "^1.64.1",
    "resend": "^6.35.0"
  }
}
